{
  "name": "pi-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A native-feeling desktop workspace for Pi coding agent sessions",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "prepare": "./scripts/prepare-effect.sh",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "e2e:fixture": "node scripts/generate-e2e-fixture.mjs",
    "e2e:serve": "npm run e2e:fixture && vite --config vite.e2e.config.ts --host 127.0.0.1 --port 5173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/michroma": "5.3.0",
    "@pierre/diffs": "^1.3.1",
    "effect": "beta",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "43.2.0",
    "electron-vite": "^5.0.0",
    "typescript": "7.0.2",
    "vite": "^7.3.1",
    "vitest": "4.1.10"
  }
}
